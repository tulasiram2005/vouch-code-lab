  {
    "id": "binary-search",
    "title": "Binary search",
    "category": "Search",
    "difficulty": "Intermediate",
    "description": "Return the index of the target in a sorted list of distinct integers, or -1 when absent.",
    "functionName": "binary_search",
    "starter": "def binary_search(values, target):\n    low = 0\n    high = len(values) - 1\n    while low <= high:\n        mid = (low + high) // 2\n        if values[mid] == target:\n            return mid\n        if values[mid] < target:\n            low = mid + 1\n        else:\n            high = mid - 1\n    return -1",
    "tests": [
      {
        "args": [
          [],
          1
        ],
        "expected": -1
      },
      {
        "args": [
          [
            2
          ],
          2
        ],
        "expected": 0
      },
