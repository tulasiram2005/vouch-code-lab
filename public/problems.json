  {
    "id": "palindrome",
    "title": "Mirror check",
    "category": "Strings",
    "difficulty": "Intermediate",
    "description": "Return True when a string reads the same forwards and backwards. Compare characters exactly.",
    "functionName": "palindrome",
    "starter": "def palindrome(text):\n    for index in range(len(text) // 2):\n        if text[index] != text[-index - 1]:\n            return False\n    return True",
    "tests": [
