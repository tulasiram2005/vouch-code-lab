    "id": "count-positives",
    "title": "Count the positives",
    "category": "Iteration",
    "difficulty": "Foundation",
    "description": "Return the number of values strictly greater than zero.",
    "functionName": "count_positives",
    "starter": "def count_positives(values):\n    count = 0\n    for value in values:\n        if value > 0:\n            count += 1\n    return count",
